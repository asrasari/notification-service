# Copy to .env and fill in PROVIDER_URL:  cp .env.example .env
# Every variable except DATABASE_URL and PROVIDER_URL has a built-in default.

# --- Server ---
# Address the API listens on.
HTTP_ADDR=:8080
# How long the API/worker wait for in-flight work on SIGTERM.
SHUTDOWN_TIMEOUT=20s

# --- Host ports (read by docker compose only) ---
# Change these if 8080/8081 are taken on your machine.
API_PORT=8080
WORKER_PORT=8081

# --- Database ---
# Postgres connection string. docker compose overrides this to reach its own Postgres service
# (which is not published to the host); this value is for running a binary outside compose.
DATABASE_URL=postgres://notifications:notifications@localhost:5432/notifications?sslmode=disable
# Maximum connections in each process's pool.
DB_MAX_CONNS=10

# --- Provider ---
# Your own webhook.site URL (create one at https://webhook.site). Required by the worker.
PROVIDER_URL=https://webhook.site/your-uuid-here
# HTTP timeout for one provider request. Must be less than LEASE_DURATION.
PROVIDER_TIMEOUT=10s

# --- Queue ---
# How long a claimed row stays reserved for one worker before it can be reclaimed.
LEASE_DURATION=30s
# How often an idle worker checks for due notifications.
POLL_INTERVAL=200ms
# Concurrent provider requests per channel.
WORKER_CONCURRENCY=50
# Share of each channel's sends for high,normal,low priority (three positive integers).
PRIORITY_WEIGHTS=70,20,10

# --- Rate limit ---
# Maximum messages per second per channel.
RATE_LIMIT_PER_CHANNEL=100

# --- Retry ---
# Total attempts per notification (first try + retries).
RETRY_MAX_ATTEMPTS=6
# Backoff base: the first retry waits about this long (with jitter).
RETRY_BASE=10s
# Upper bound for a single backoff wait. Must be greater than RETRY_BASE.
RETRY_CAP=10m
# Longest channel pause honoured from a provider's Retry-After header.
RETRY_AFTER_CAP=5m

# --- Circuit breaker (per channel) ---
# Rolling window over which failures are counted.
BREAKER_WINDOW=10s
# Minimum requests in the window before the breaker may open.
BREAKER_MIN_REQUESTS=20
# Failure ratio in (0, 1] that opens the breaker.
BREAKER_FAILURE_RATIO=0.5
# How long the breaker stays open before letting one probe request through.
BREAKER_OPEN_TIMEOUT=30s

# --- Worker ---
# Address of the worker's own HTTP server (/health; /metrics later).
WORKER_HTTP_ADDR=:8081
# How often the worker records its heartbeat in the database.
HEARTBEAT_INTERVAL=5s

# --- Logging ---
# debug, info, warn or error.
LOG_LEVEL=info
# json (default) or text for local development.
LOG_FORMAT=json
